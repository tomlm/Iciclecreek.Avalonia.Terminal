<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Iciclecreek.Terminal">
    
    <!-- FontFamily is set here rather than only as a default value, because a default LOSES to an inherited
         one: FluentTheme puts a proportional font (Inter) on the tree and it flows straight down into the
         terminal. A terminal in a proportional font is broken, not just ugly - the cell grid comes from one
         measured advance width. A host setting FontFamily directly still wins over this setter.

         The emoji fonts sit AFTER the monospace ones and never in front of them, for that same reason: the
         grid is measured from the first font, and these are proportional. They are only consulted for
         codepoints the monospace fonts do not have.

         They are named because leaving the fallback to chance picks badly for a joined sequence. Without an
         emoji font in the chain, a cluster the monospace font cannot shape falls to whatever monochrome
         symbol font happens to carry the COMPONENTS - so the parts get drawn side by side inside one cell,
         in the terminal's foreground colour, instead of the single glyph they spell. Measured against
         ucs-detect's 1,445 ZWJ sequences, which is where that is easiest to see. -->
    <Style Selector="local|TerminalControl">
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Cascadia Mono,Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,Courier New,Segoe UI Emoji,Apple Color Emoji,Noto Color Emoji,monospace"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The scrollbar keeps its own column and never gives it up.

                     Hiding it collapsed the Auto column, the terminal grew into it, and the process was
                     told the terminal had changed width — mid-frame, for a program that had just switched
                     to the alternate buffer, which is what hid the bar in the first place.

                     Overlaying it on the terminal would also keep the width fixed, but the bar would then
                     sit over real cells and eat the mouse events belonging to them. These programs turn
                     mouse reporting on; the cells under an overlay would stop being clickable.

                     So it stays, always, exactly as Windows Terminal and xterm leave it. It goes inert
                     rather than absent when there is nothing to scroll. -->
                <Grid ColumnDefinitions="*,Auto">
                    <local:TerminalView Name="PART_TerminalView"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontStyle="{TemplateBinding FontStyle}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Background="{TemplateBinding Background}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       Process="{TemplateBinding Process}"
                                       StartingDirectory="{TemplateBinding StartingDirectory}"
                                       Args="{TemplateBinding Args}"
                                       BufferSize="{TemplateBinding BufferSize}"
                                       ShowCaretOnClick="{TemplateBinding ShowCaretOnClick}"
                                       ShortcutMode="{TemplateBinding ShortcutMode}"
                                       SuppressCursor="{TemplateBinding SuppressCursor}"
                                       OutputReceivedOnReadTask="{TemplateBinding OutputReceivedOnReadTask}"
                                       AutoScrollToBottom="{TemplateBinding AutoScrollToBottom}"
                                       TextDecorations="{TemplateBinding TextDecorations}"
                                       CursorColor="{TemplateBinding CursorColor}"
                                       Ligatures="{TemplateBinding Ligatures}"
                                       ConvertEol="{TemplateBinding ConvertEol}"
                                       AllowWindowOps="{TemplateBinding AllowWindowOps}"
                                       UseSkiaRenderer="{TemplateBinding UseSkiaRenderer}"
                                       CursorStyle="{TemplateBinding CursorStyle}"
                                       CursorBlink="{TemplateBinding CursorBlink}"
                                       CursorBlinkRate="{TemplateBinding CursorBlinkRate}"
                                       VerbatimCommandLine="{TemplateBinding VerbatimCommandLine}"
                                       EnvironmentVariables="{TemplateBinding EnvironmentVariables}"
                                       Options="{TemplateBinding Options}"
                                       GutterWidth="{TemplateBinding GutterWidth}"
                                       GutterPromptBrush="{TemplateBinding GutterPromptBrush}"
                                       GutterSuccessBrush="{TemplateBinding GutterSuccessBrush}"
                                       GutterFailureBrush="{TemplateBinding GutterFailureBrush}"
                                       SearchHighlightBrush="{TemplateBinding SearchHighlightBrush}"
                                       SearchCurrentBrush="{TemplateBinding SearchCurrentBrush}"/>
                    <!-- Scrollbar -->
                    <ScrollBar Name="PART_ScrollBar"
                              Grid.Column="1"
                              Orientation="Vertical"
                              AllowAutoHide="False"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
