<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <Description>Avalonia terminal controls (TerminalControl/TerminalWindow) that provide an XTerm console for hosting console applications in Avalonia, including Sixel and Kitty graphics.</Description>
    <Company>Iciclecreek</Company>
    <Authors>Tom Laird-McConnell</Authors>
    <Keyword>xterm;terminal;avalonia</Keyword>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tomlm/Iciclecreek.Avalonia.Terminal</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/tomlm/Iciclecreek.Avalonia.Terminal/master/icon.png</PackageIconUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/tomlm/Iciclecreek.Avalonia.Terminal</RepositoryUrl>
    <Copyright>Tom Laird-McConnell All Rights Reserved</Copyright>
    <RootNamespace>Iciclecreek.TerminalWindow</RootNamespace>
    <ContentTargetFolders>content</ContentTargetFolders>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Porta.Pty" Version="2.2.0" />
    <PackageReference Include="Unicode.net" Version="2.0.0" />
    <PackageReference Include="Wcwidth" Version="4.0.1" />
  </ItemGroup>

  <!-- The emulator: a sibling checkout when there is one, the published package otherwise.

       This is the arrangement Iciclecreek.Avalonia.TerminalWindow.Local.slnx describes; its
       comment says "the reference itself is conditional and lives in the csproj", and until now
       that was the intent rather than the fact. The condition makes it true: clone XTerm.NET
       beside this repository and every build picks up emulator changes with no packing step, while
       machines without the sibling, the build agents first among them, restore the package
       exactly as before.

       The property indirection is what keeps the condition honest on both legs. Exists() answers
       once, and both the include and the exclude read the same answer, where two separate Exists()
       calls could disagree if the sibling appeared mid-evaluation. Far-fetched, but a
       reference that is both a project and a package is a confusing enough failure to close off
       for one property. -->
  <PropertyGroup>
    <SiblingXTerm>$(MSBuildThisFileDirectory)../../../XTerm.NET/src/XTerm.NET/XTerm.NET.csproj</SiblingXTerm>
    <UseSiblingXTerm Condition="Exists('$(SiblingXTerm)')">true</UseSiblingXTerm>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SiblingXTerm)" Condition="'$(UseSiblingXTerm)' == 'true'" />
    <PackageReference Include="XTerm.NET" Version="2.0.0-rc002" Condition="'$(UseSiblingXTerm)' != 'true'" />
  </ItemGroup>
</Project>
